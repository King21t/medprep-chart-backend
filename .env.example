DATABASE_URL="postgresql://user:password@localhost:5432/medprep_chart"
JWT_SECRET="replace-with-a-long-random-string"

# Which AI provider generates practice questions: "groq" (free, default) or "claude"
AI_PROVIDER="groq"
GROQ_API_KEY="gsk_..."

# Only needed once AI_PROVIDER is switched to "claude"
ANTHROPIC_API_KEY="sk-ant-..."

PORT=4000
CLIENT_URL="http://localhost:5173"
ADMIN_SECRET="replace-with-your-own-admin-password"
